<?xml version="1.0"?>
<package format="3">
  <name>robot_sim</name><version>0.1.0</version>
  <description>Gazebo Classic office simulation and C++ mapping route tool.</description>
  <maintainer email="maintainer@example.invalid">Robot maintainer</maintainer>
  <license>MIT</license>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>geometry_msgs</depend><depend>sensor_msgs</depend><depend>tf2_ros</depend>
  <depend>gazebo_ros</depend><depend>gazebo_dev</depend>
  <depend>nav_msgs</depend><depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>robot_description</exec_depend><exec_depend>robot_state_publisher</exec_depend><exec_depend>xacro</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>mid360_simulation</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/../../lib"/>
  </export>
</package>
