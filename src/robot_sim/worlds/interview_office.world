<?xml version="1.0"?>
<!-- Inspired by the official Gazebo SDF world examples; all geometry is local for offline use. -->
<sdf version="1.6">
  <world name="interview_office">
    <gravity>0 0 -9.81</gravity>
    <physics name="default_phys" type="ode"><max_step_size>0.002</max_step_size><real_time_update_rate>500</real_time_update_rate><real_time_factor>1.0</real_time_factor></physics>
    <gui><camera name="user_camera"><pose>0 -13 12 0 0.75 1.57079632679</pose><view_controller>orbit</view_controller></camera></gui>
    <scene><ambient>0.45 0.45 0.45 1</ambient><background>0.72 0.76 0.82 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0.4 0.2 -0.5</pose><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.15 0.15 0.15 1</specular><direction>-0.4 0.2 -1</direction></light>

    <model name="floor"><static>true</static><pose>0 0 -0.05 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>12 12 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>12 12 0.1</size></box></geometry><material><ambient>0.68 0.66 0.60 1</ambient><diffuse>0.68 0.66 0.60 1</diffuse></material></visual></link></model>

    <!-- Outer walls: 12 m x 12 m -->
    <model name="north_wall"><static>true</static><pose>0 6 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12 0.15 2</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.15 2</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient><diffuse>0.78 0.78 0.82 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -6 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>12 0.15 2</size></box></geometry></collision><visual name="v"><geometry><box><size>12 0.15 2</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient><diffuse>0.78 0.78 0.82 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>6 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 12 2</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient><diffuse>0.78 0.78 0.82 1</diffuse></material></visual></link></model>
    <model name="west_wall"><static>true</static><pose>-6 0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 12 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 12 2</size></box></geometry><material><ambient>0.78 0.78 0.82 1</ambient><diffuse>0.78 0.78 0.82 1</diffuse></material></visual></link></model>

    <!-- Partitions leave navigable door openings. -->
    <model name="partition_a"><static>true</static><pose>-1.8 2.2 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>4.2 0.15 2</size></box></geometry></collision><visual name="v"><geometry><box><size>4.2 0.15 2</size></box></geometry><material><ambient>0.88 0.72 0.45 1</ambient><diffuse>0.88 0.72 0.45 1</diffuse></material></visual></link></model>
    <model name="partition_b"><static>true</static><pose>2.0 -1.9 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 4.0 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 4.0 2</size></box></geometry><material><ambient>0.40 0.66 0.82 1</ambient><diffuse>0.40 0.66 0.82 1</diffuse></material></visual></link></model>
    <model name="partition_c"><static>true</static><pose>-3.6 -2.0 1 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.15 3.7 2</size></box></geometry></collision><visual name="v"><geometry><box><size>0.15 3.7 2</size></box></geometry><material><ambient>0.64 0.82 0.52 1</ambient><diffuse>0.64 0.82 0.52 1</diffuse></material></visual></link></model>

    <!-- Static furniture/obstacles -->
    <model name="table_1"><static>true</static><pose>3.8 3.7 0.45 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>1.2 0.8 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.8 0.9</size></box></geometry><material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.35 0.18 0.08 1</diffuse></material></visual></link></model>
    <model name="table_2"><static>true</static><pose>-4.2 3.8 0.45 0 0 0.3</pose><link name="link"><collision name="c"><geometry><box><size>1.2 0.8 0.9</size></box></geometry></collision><visual name="v"><geometry><box><size>1.2 0.8 0.9</size></box></geometry><material><ambient>0.35 0.18 0.08 1</ambient><diffuse>0.35 0.18 0.08 1</diffuse></material></visual></link></model>
    <model name="crate_1"><static>true</static><pose>4.1 -3.8 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.82 0.48 0.16 1</ambient><diffuse>0.82 0.48 0.16 1</diffuse></material></visual></link></model>
    <model name="crate_2"><static>true</static><pose>4.8 -3.8 0.35 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>0.7 0.7 0.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.7 0.7 0.7</size></box></geometry><material><ambient>0.82 0.48 0.16 1</ambient><diffuse>0.82 0.48 0.16 1</diffuse></material></visual></link></model>

  </world>
</sdf>
