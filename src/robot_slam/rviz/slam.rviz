Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
    Background Color: 40; 42; 45
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 30
    - Class: rviz_default_plugins/RobotModel
      Name: Baobao
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
    - Class: rviz_default_plugins/Map
      Name: Navigation map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Alpha: 0.6
    - Class: rviz_default_plugins/PointCloud2
      Name: MID360 live cloud
      Enabled: true
      Topic:
        Value: /livox/lidar
        Reliability Policy: Best Effort
        Depth: 2
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Decay Time: 0.1
      Alpha: 1
    - Class: rviz_default_plugins/PointCloud2
      Name: Loop optimized map
      Enabled: true
      Topic:
        Value: /mapping/cloud_map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 0.8
    - Class: rviz_default_plugins/PointCloud2
      Name: Localization map
      Enabled: true
      Topic:
        Value: /localization/cloud_map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Style: Points
      Size (Pixels): 2
      Color Transformer: AxisColor
      Axis: Z
      Alpha: 0.8
    - Class: rviz_default_plugins/Path
      Name: Global plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
        Depth: 1
      Color: 0; 255; 0
      Alpha: 1
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Focal Point: {X: 0, Y: 0, Z: 0.5}
      Pitch: 0.9
      Yaw: 0.5
Window Geometry:
  Width: 1400
  Height: 900
